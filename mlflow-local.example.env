# Throwaway credentials for a LOCAL, standalone `docker compose up` of compose.yml (nothing here is
# a secret, and none of it may be used on a shared or public host). compose.yml has no defaults:
# pass this file explicitly, together with your own MLFLOW_AUTH_* values:
#   docker compose --env-file mlflow-local.example.env --env-file .env up -d --build --wait
# The production overlay (compose.gateway.yml) requires its own generated values instead.
MLFLOW_DB_PASSWORD=mlflow-local-password
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-local-password
