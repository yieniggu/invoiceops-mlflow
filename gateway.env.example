# Production gateway overlay variables (compose.gateway.yml, MLOPS-02).
# Append these to your untracked .env, next to the MLFLOW_AUTH_* values of .env.example.
# Use hex/alphanumeric secrets (openssl rand -hex 24): they are embedded in URLs.
# The gateway refuses to start unless MLFLOW_AUTH_ADMIN_PASSWORD and
# INTERNAL_INTROSPECTION_SECRET have 32-512 characters without whitespace.
MLFLOW_DB_PASSWORD=replace-with-generated-db-password
MINIO_ROOT_USER=replace-with-generated-minio-user
MINIO_ROOT_PASSWORD=replace-with-generated-minio-password
# Same value as INTERNAL_INTROSPECTION_SECRET of invoiceops-app.
INTERNAL_INTROSPECTION_SECRET=replace-with-the-app-introspection-secret
# Browser-facing origin of this gateway (no path). Must equal MLFLOW_PUBLIC_URL of invoiceops-app:
# the app only redirects back to <this origin>/_gateway/callback.
GATEWAY_PUBLIC_ORIGIN=https://mlflow-invoiceops.aglai.dev
# Browser-facing origin of InvoiceOps (no path, https in production). Browsers without a gateway
# session are redirected to <this origin>/api/v1/mlflow/authorize. Both hosts keep host-only
# cookies: do NOT set SESSION_COOKIE_DOMAIN in invoiceops-app.
APP_PUBLIC_URL=https://invoiceops.aglai.dev
# Optional: read-only service identity for the Model API/backend
# (32-512 chars, sent as Bearer plus X-InvoiceOps-Workspace).
GATEWAY_SERVICE_READ_TOKEN=
# External docker networks created by the invoiceops-app stack / the tunnel host. Both must exist
# before `up`. These are the production defaults; they can be omitted.
GATEWAY_EDGE_NETWORK=aglai_edge
GATEWAY_BACKEND_NETWORK=invoiceops_api
GATEWAY_INTROSPECTION_URL=http://invoiceops-backend:3000
# Optional abuse bounds (defaults shown; see gateway/GATEWAY.md, "Abuse bounds").
# GATEWAY_MAX_CONCURRENT_PER_PRINCIPAL=16
# GATEWAY_UPLOAD_DEADLINE_SECONDS=3600
# GATEWAY_AUTH_FAILURE_LIMIT=120
# GATEWAY_AUTH_FAILURE_WINDOW_SECONDS=60
# GATEWAY_HANDOFF_FAILURE_LIMIT=20
# GATEWAY_MAX_BODY_BYTES=10485760
# GATEWAY_MAX_ARTIFACT_BYTES=10737418240
# GATEWAY_CACHE_ACTIVE_SECONDS=30
# GATEWAY_CACHE_INACTIVE_SECONDS=5
# GATEWAY_CONTEXT_COOKIE_MAX_AGE=43200
# Header with the real client IP behind the tunnel (compose default when UNSET: cf-connecting-ip).
# Set it EMPTY (GATEWAY_CLIENT_IP_HEADER=) to use the TCP peer address instead.
# GATEWAY_CLIENT_IP_HEADER=cf-connecting-ip
# Optional dedicated HMAC key (32-512 chars, no whitespace) of the principal digest in the audit log.
# Empty (default): HMAC-SHA-256(GATEWAY_INTROSPECTION_SECRET, "invoiceops-mlflow-gateway/audit-key/v1"),
# so the introspection secret itself is never used to key logs.
# GATEWAY_AUDIT_HMAC_KEY=
