# Copy to smoke.env and replace every placeholder with unique local-only values.
# This file is intentionally non-secret and must not be used unchanged.
MLFLOW_AUTH_ADMIN_USERNAME=replace-with-initial-admin-username
MLFLOW_AUTH_ADMIN_PASSWORD=replace-with-generated-password
MLFLOW_FLASK_SERVER_SECRET_KEY=replace-with-generated-secret-key
MLFLOW_DB_PASSWORD=replace-with-generated-db-password
MINIO_ROOT_USER=replace-with-generated-minio-user
MINIO_ROOT_PASSWORD=replace-with-generated-minio-password
