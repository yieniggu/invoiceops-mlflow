# Copy to invoiceops-local.env (ignored); replace every placeholder with a unique local value.
# Use URL-safe alphanumeric values for DB/MinIO credentials (URI interpolation is not escaped).
LOCAL_MLFLOW_DB_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
LOCAL_MINIO_USER=REPLACE_WITH_LOCAL_USER
LOCAL_MINIO_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
MLFLOW_AUTH_ADMIN_USERNAME=REPLACE_WITH_LOCAL_ADMIN
MLFLOW_AUTH_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_VALUE
MLFLOW_FLASK_SERVER_SECRET_KEY=REPLACE_WITH_ANOTHER_UNIQUE_RANDOM_VALUE
LOCAL_MODEL_API_ADMIN_TOKEN=REPLACE_WITH_ANOTHER_UNIQUE_RANDOM_VALUE
POSTGRES_USER=invoiceops
POSTGRES_DB=invoiceops
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
LOCAL_MLFLOW_PORT=5500
LOCAL_APP_DB_PORT=5544
LOCAL_BACKEND_PORT=5300
LOCAL_FRONTEND_PORT=5174
LOCAL_MODEL_API_PORT=5800
